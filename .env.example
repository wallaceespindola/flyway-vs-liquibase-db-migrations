# Copy to .env and adjust as needed. Nothing here is secret — the demo runs entirely on local H2
# files with the default H2 `sa` account and no password.
#
# Author: Wallace Espindola

# Port the application listens on.
SERVER_PORT=8080

# Spring profile. The default profile is all this demo needs.
SPRING_PROFILES_ACTIVE=default

# JVM options passed to the container entrypoint.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# H2 database locations. Each engine owns one database; they are deliberately separate so Flyway and
# Liquibase never touch the same schema.
APP_DATASOURCE_FLYWAY_URL=jdbc:h2:file:./data/flywaydb;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE;NON_KEYWORDS=VALUE
APP_DATASOURCE_LIQUIBASE_URL=jdbc:h2:file:./data/liquibasedb;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE;NON_KEYWORDS=VALUE

# Liquibase contexts. The demo changelog tags its changesets with `demo`.
APP_MIGRATION_LIQUIBASE_CONTEXTS=demo
